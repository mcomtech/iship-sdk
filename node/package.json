{
  "name": "@iship/sdk",
  "version": "1.0.0",
  "description": "Client for the iShip shipping API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcomtech/iship-sdk.git",
    "directory": "node"
  }
