{
  "name": "iship/sdk",
  "description": "Client for the iShip shipping API",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "IShip\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IShip\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "sort-packages": true
  }
}
